{
  "name": "oppivelvollisuus-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "Frontend for oppivelvollisuus",
  "scripts": {
    "clean": "rm -rf dist node_modules/.cache",
    "dev": "concurrently -n tsc,esbuild -c blue,green 'yarn type-check:watch' 'yarn build:serve'",
    "lint": "oxfmt -c ../.oxfmtrc.json --check && oxlint",
    "lint:fix": "oxfmt -c ../.oxfmtrc.json && oxlint --fix",
    "type-check": "tsc --build --force .",
    "type-check:watch": "yarn type-check --watch --preserveWatchOutput",
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "build:serve": "node build.js --dev --watch --serve"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "autosize": "6.0.1",
    "classnames": "2.5.1",
    "core-js": "3.50.0",
    "date-fns": "4.4.0",
    "lodash": "4.18.1",
    "polished": "4.3.1",
    "react": "19.3.0",
    "react-csv": "2.2.2",
    "react-dom": "19.3.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@types/autosize": "4.0.3",
    "@types/lodash": "4.17.25",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-csv": "1.1.10",
    "@types/react-dom": "19.3.0",
    "@types/styled-components": "5.1.36",
    "axios": "1.20.0",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint-plugin-lodash": "8.1.0",
    "express": "5.3.0",
    "express-http-proxy": "2.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "8.5.29",
    "postcss-preset-env": "11.6.1",
    "react-router": "8.4.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "yargs": "18.2.0"
  },
  "resolutions": {
    "shell-quote": "1.12.0"
  },
  "engines": {
    "node": ">= 20.11.0"
  },
  "packageManager": "yarn@4.18.1",
  "postcss": {
    "plugins": {
      "postcss-preset-env": true
    }
  }
}
