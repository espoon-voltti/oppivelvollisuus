{
  "name": "oppivelvollisuus-api-gateway",
  "version": "0.0.1",
  "private": true,
  "description": "API gateway for oppivelvollisuus",
  "license": "LGPL-2.1-or-later",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./build ./dist",
    "type-check": "tsc",
    "lint": "oxfmt -c ../.oxfmtrc.json --check && oxlint",
    "lint:fix": "oxfmt -c ../.oxfmtrc.json && oxlint --fix",
    "test": "NODE_ENV=test vitest run",
    "dev": "concurrently --prefix '[{name}]' --names 'tsc,node' 'tsc --preserveWatchOutput --watch' 'NODE_ENV=local node --watch-preserve-output --watch src/index.ts'",
    "prepack": "exit 1"
  },
  "dependencies": {
    "@node-saml/node-saml": "5.1.0",
    "axios": "1.20.0",
    "connect-redis": "10.0.0",
    "cookie-parser": "1.4.7",
    "date-fns": "4.4.0",
    "dd-trace": "6.20.1",
    "express": "5.3.0",
    "express-http-proxy": "2.1.2",
    "express-session": "1.19.0",
    "fast-xml-parser": "5.11.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "make-error-cause": "2.3.0",
    "nocache": "4.0.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "pump": "3.0.4",
    "query-string": "9.5.1",
    "redis": "6.3.0",
    "split2": "4.2.0",
    "through2": "5.0.11",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express-http-proxy": "1.6.7",
    "@types/express-session": "1.19.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.25",
    "@types/ms": "2.1.0",
    "@types/node": "25.9.9",
    "@types/node-forge": "1.3.14",
    "@types/pump": "1.1.3",
    "@types/readable-stream": "4.0.25",
    "@types/split2": "4.2.3",
    "@types/tough-cookie": "4.0.5",
    "@types/xml2js": "0.4.14",
    "concurrently": "10.0.6",
    "nock": "15.0.1",
    "node-forge": "1.4.0",
    "nodemon": "3.1.14",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tough-cookie": "6.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "xml-crypto": "6.3.3",
    "xml2js": "0.6.2"
  },
  "resolutions": {
    "@types/ms": "2.1.0",
    "shell-quote": "1.12.0"
  },
  "engines": {
    "node": ">= 22.18.0"
  },
  "packageManager": "yarn@4.18.1"
}
